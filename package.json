{
  "name": "multi-agent-platform",
  "version": "1.0.0",
  "description": "Multi-Agent协作平台 - 本地化运行的多智能体协作工具",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:frontend": "cd frontend-src && npm run build",
    "test": "node tests/verification.js",
    "test:prompt": "node tests/prompt-context.test.js",
    "test:template": "node tests/prompt-template.test.js",
    "test:planning": "node tests/task-planning.test.js",
    "test:routing": "node tests/event-driven-routing.test.js",
    "test:cancel": "node tests/cancel-turn.test.js",
    "test:mention": "node tests/mention.test.js",
    "test:messaging": "node tests/message-log.test.js",
    "test:resume": "node tests/resume-runtime.test.js",
    "test:turn": "node tests/turn-routing.test.js",
    "test:modes": "node tests/collab-modes-disabled.test.js",
    "probe:cli": "node scripts/probe-cli.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "js-yaml": "^4.1.0",
    "uuid": "^10.0.0",
    "archiver": "^7.0.1",
    "chokidar": "^4.0.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  }
